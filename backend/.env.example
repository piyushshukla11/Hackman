# PRISM Backend Environment Configuration
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prism
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# External AI / ML Services
GEMINI_KEY=
SARVAM_KEY=

# Mail Provider (Resend / Postmark)
MAIL_PROVIDER=resend
MAIL_PROVIDER_KEY=
MAIL_FROM=noreply@prism.app

# Alerts
SLACK_WEBHOOK=

# Feature flags
ENABLE_VISION=true
ENABLE_STT=true
ENABLE_SARVAM=true
LLM_FALLBACK_ENABLED=true
